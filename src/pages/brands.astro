---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';
import { brands, commercials, brandStoryHref } from '../data/brands';
import { youtubeThumb, youtubeThumbFallback, youtubeUrl } from '../data/episodes';

const isYouTube = (src: string) => src.includes('i.ytimg.com');
---

<BaseLayout
  title="Brands"
  description="Jeremy's Razors and Jeremy's Chocolates: the consumer brands of Boreing Media, acquired from The Daily Wire in July 2026."
>
  <PageHero
    eyebrow="Brands"
    title="Built because someone said no."
    lead="In 2022 a razor company walked away from a sponsorship. Jeremy built a better one. Four years and $55 million later, the brands are back home."
    palette="poster-ember"
    image={brands[0].card}
  >
    {brands.map((b) => <a href={b.href} target="_blank" rel="noopener" class="btn btn-outline">{b.hrefLabel}</a>)}
  </PageHero>

  {
    brands.map((b, i) => (
      <section id={b.id} class={`py-20 sm:py-28 ${i % 2 === 1 ? 'section-paper' : ''}`} aria-labelledby={`${b.id}-heading`}>
        <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
          <div class={`lg:col-span-6 ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
            <div class={`${b.palette} relative aspect-[4/3] overflow-hidden rounded-2xl`} data-reveal>
              <img
                src={b.hero}
                alt={`${b.name} product photography`}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                referrerpolicy="no-referrer"
                class="absolute inset-0 size-full object-cover"
                onerror={isYouTube(b.hero) ? youtubeThumbFallback : undefined}
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/10 to-transparent" />
              <div class="absolute left-6 top-6 rounded-full border border-white/20 bg-black/40 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white backdrop-blur">
                {b.category}
              </div>
              <div class="absolute inset-x-6 bottom-6">
                <p class="font-display text-3xl leading-none text-white sm:text-4xl">{b.name}</p>
                <p class="mt-2 text-sm text-white/80">Est. {b.founded}</p>
              </div>
            </div>
          </div>
          <div class={`lg:col-span-6 ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
            <SectionHeading eyebrow={b.category} title={b.name} lead={b.intro} />
            <p class="mt-6 max-w-xl leading-relaxed text-ink/85" data-reveal>
              {b.story}
            </p>
            <dl class="mt-8 grid grid-cols-3 gap-4" data-reveal>
              {b.stats.map((s) => (
                <div class="card p-4">
                  <dd class="font-display text-2xl text-gold">{s.value}</dd>
                  <dt class="mt-1 text-xs text-muted">{s.label}</dt>
                </div>
              ))}
            </dl>
            <ul class="mt-8 grid gap-3 sm:grid-cols-2" data-reveal>
              {b.products.map((p) => {
                const Tag = p.href ? 'a' : 'div';
                return (
                  <li>
                    <Tag
                      href={p.href}
                      target={p.href ? '_blank' : undefined}
                      rel={p.href ? 'noopener' : undefined}
                      class="card card-hover group flex items-center gap-4 p-3 pr-4"
                    >
                      {p.image ? (
                        <span class="grid size-20 shrink-0 place-items-center overflow-hidden rounded-xl bg-white/90 p-1.5">
                          <img src={p.image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="max-h-full max-w-full object-contain" />
                        </span>
                      ) : (
                        <span class={`${b.palette} grain relative grid size-20 shrink-0 place-items-center overflow-hidden rounded-xl font-display text-2xl text-white`}>
                          <span class="relative">{p.name.slice(0, 2)}</span>
                        </span>
                      )}
                      <span class="min-w-0 flex-1">
                        <span class="flex items-baseline justify-between gap-3">
                          <span class="truncate text-sm font-semibold transition-colors group-hover:text-gold">{p.name}</span>
                          {p.price && <span class="shrink-0 text-sm font-medium text-gold">{p.price}</span>}
                        </span>
                        <span class="mt-0.5 block text-xs text-muted">{p.note}</span>
                      </span>
                    </Tag>
                  </li>
                );
              })}
            </ul>
            <div class="mt-8 flex flex-wrap gap-3" data-reveal>
              <a href={b.href} target="_blank" rel="noopener" class="btn btn-primary">
                {b.hrefLabel}
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17L17 7M9 7h8v8" />
                </svg>
              </a>
              {b.id === 'chocolates' && (
                <a href={brandStoryHref} target="_blank" rel="noopener" class="btn btn-outline">
                  The brand story
                </a>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="border-t border-border/60 py-20 sm:py-28" aria-labelledby="commercials-heading">
    <div class="container-x">
      <SectionHeading
        eyebrow="The commercials"
        title="Ads people chose to watch."
        lead="Forty-five million views across three spots. The brands were built on the show's audience and on commercials that became the content."
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          commercials.map((c, i) => (
            <a
              href={youtubeUrl(c.youtubeId)}
              target="_blank"
              rel="noopener"
              class="card card-hover group overflow-hidden"
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <span class="relative block aspect-video overflow-hidden">
                <img
                  src={youtubeThumb(c.youtubeId)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105"
                  onerror={youtubeThumbFallback}
                />
                <span class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent" />
                <span class="absolute bottom-3 left-3 rounded bg-black/70 px-2 py-0.5 text-xs font-semibold text-white">{c.views} views</span>
                <span class="absolute inset-0 grid place-items-center opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                  <span class="grid size-12 place-items-center rounded-full bg-white/90 text-black">
                    <svg class="ml-0.5 size-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
                  </span>
                </span>
              </span>
              <span class="block p-5">
                <span class="text-xs text-muted">{c.brand} &middot; {c.year}</span>
                <span class="mt-1 block font-sans text-base font-semibold leading-snug transition-colors group-hover:text-gold">{c.title}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Wholesale & partnerships"
    title="Put the brands on your shelf."
    text="Retail, co-branded products, and bundles. Tell us what you have in mind."
    primary={{ label: 'Partner with us', href: '/advertise' }}
    secondary={{ label: 'Contact', href: '/contact' }}
  />
</BaseLayout>
