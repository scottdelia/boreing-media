---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PressCard from '../components/PressCard.astro';
import { withBase } from '../lib/url';
import { press } from '../data/press';

const [lead, ...rest] = press;
---

<BaseLayout title="News & Press" description="Press coverage of Boreing Media, The Jeremy Boreing Show, and Jeremy Boreing. Media contact and background.">
  <PageHero
    eyebrow="News & Press"
    title="In the news."
    lead="Coverage of the company, the show, and the brands, newest first. Every link goes to the original outlet."
    palette="poster-plum"
  />

  <section class="container-x pb-16 sm:pb-24">
    <a
      href={lead.href}
      target="_blank"
      rel="noopener"
      class="card card-hover grain group relative block overflow-hidden p-8 sm:p-12"
      data-reveal
    >
      <div class="poster-plum absolute inset-0 opacity-40"></div>
      <div class="absolute inset-0 bg-linear-to-r from-bg via-bg/80 to-bg/30"></div>
      <div class="relative max-w-3xl">
        <p class="eyebrow">Latest &middot; {lead.outlet}</p>
        <h2 class="mt-4 text-3xl font-medium tracking-tight transition-colors group-hover:text-gold sm:text-5xl">{lead.title}</h2>
        <p class="mt-4 text-lg text-muted">{lead.summary}</p>
        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-gold">
          Read the story
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M9 7h8v8" />
          </svg>
        </span>
      </div>
    </a>

    <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((item, i) => (
          <div data-reveal style={`--reveal-delay: ${(i % 3) * 70}ms`}>
            <PressCard item={item} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="section-paper py-20 sm:py-28">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="Media inquiries"
          title="Press contact"
          lead="Interview requests, background, and fact checks. Use the contact form and choose Press."
        />
        <div class="mt-8" data-reveal>
          <a href={`${withBase('/contact')}?type=Press`} class="btn btn-primary">Contact press</a>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
        <div class="card p-6" data-reveal>
          <p class="eyebrow">Boilerplate</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Boreing Media is the media and consumer brands company founded in 2026 by Jeremy Boreing, co-founder and
            former co-CEO of The Daily Wire. It produces The Jeremy Boreing Show, develops film and television, and owns
            Jeremy's Razors and Jeremy's Chocolates.
          </p>
        </div>
        <div class="card p-6" data-reveal style="--reveal-delay: 80ms">
          <p class="eyebrow">Assets</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Logos, headshots, and show art are available on request. Please do not crop or recolor the marks.
          </p>
          <p class="mt-3 text-xs text-muted/70">Concept note: an asset kit is a follow-up item.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
