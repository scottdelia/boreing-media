---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';
import { leadership, timeline, values } from '../data/leadership';
import { showArtwork, youtubeThumb } from '../data/episodes';

// Behind-the-scenes still of Boreing directing on The Pendragon Cycle, from the show's channel.
const heroImage = youtubeThumb('1HFE_dpXo6U');
---

<BaseLayout
  title="About"
  description="Boreing Media was founded in 2026 by Jeremy Boreing, co-founder and former co-CEO of The Daily Wire. A show, a studio, and consumer brands."
>
  <PageHero
    eyebrow="About"
    title="Build your own."
    lead="Boreing Media is what happens when a founder leaves the company he built and starts again with the parts he liked best: a conversation, a camera, and a couple of products people actually buy."
    palette="poster-gold"
    image={heroImage}
  />

  <section class="container-x py-16 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow="The story" title="From co-founder to founder." />
        <figure class="mt-8 max-w-xs" data-reveal>
          <img
            src={showArtwork}
            alt="Jeremy Boreing"
            width="600"
            height="600"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            class="w-full rounded-2xl shadow-2xl shadow-black/40"
          />
          <figcaption class="mt-3 text-xs text-muted">Jeremy Boreing, founder. Portrait from The Jeremy Boreing Show.</figcaption>
        </figure>
      </div>
      <div class="space-y-5 leading-relaxed text-ink/85 lg:col-span-7" data-reveal>
        <p>
          Jeremy Boreing co-founded The Daily Wire in 2015 and ran it as co-CEO for ten years. Along the way he built
          the company's entertainment arm from nothing: feature films, the highest-grossing documentary of 2024, a
          fantasy series, and a slate of kids programming.
        </p>
        <p>
          In March 2025 he stepped away from the CEO role to focus on creative work. Twelve months later he launched The
          Jeremy Boreing Show. In July 2026, Boreing Media bought Jeremy's Razors and Jeremy's Chocolates back from The
          Daily Wire, reuniting the founder with the brands that carry his name.
        </p>
        <blockquote class="border-l-2 border-gold pl-6">
          <p class="font-display text-2xl italic leading-snug text-ink">
            &ldquo;Start building our own instead.&rdquo;
          </p>
          <footer class="mt-3 text-sm text-muted">Jeremy Boreing, on why Jeremy&rsquo;s Razors exists</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section-paper py-20 sm:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="Timeline" title="How we got here." />
      <ol class="mt-12 grid gap-6 md:grid-cols-5">
        {
          timeline.map((t, i) => (
            <li class="relative border-t border-border pt-6" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
              <span class="absolute -top-px left-0 h-px w-10 bg-gold" aria-hidden="true" />
              <p class="font-display text-3xl text-gold">{t.year}</p>
              <h3 class="mt-3 font-sans text-base font-semibold">{t.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{t.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container-x py-20 sm:py-28">
    <SectionHeading eyebrow="Leadership" title="Who runs it." />
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        leadership.map((l, i) => (
          <article class="card card-hover flex flex-col overflow-hidden" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <div class={`${l.palette} relative aspect-[4/3] overflow-hidden`}>
              {l.photo ? (
                <img
                  src={l.photo}
                  alt={l.name}
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class="absolute inset-0 size-full object-cover object-top"
                />
              ) : (
                <div class="grain absolute inset-0 grid place-items-center font-display text-6xl text-white" aria-hidden="true">
                  <span class="relative">{l.initials}</span>
                </div>
              )}
              <div class="absolute inset-0 bg-linear-to-t from-surface/90 via-transparent to-transparent" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-2xl font-medium tracking-tight">{l.name}</h3>
              <p class="mt-1 text-sm font-medium text-gold">{l.role}</p>
              <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">{l.bio}</p>
              {l.photoCredit && (
                <p class="mt-4 text-[11px] text-muted/70">
                  Photo:{' '}
                  <a href={l.photoCreditHref} target="_blank" rel="noopener" class="underline decoration-border underline-offset-2 hover:text-gold">
                    {l.photoCredit}
                  </a>
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-t border-border/60 bg-surface/30 py-20 sm:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="Values" title="What we believe." />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v, i) => (
            <div class="card p-6" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
              <span class="font-display text-3xl text-gold">0{i + 1}</span>
              <h3 class="mt-4 font-sans text-base font-semibold">{v.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Press"
    title="Writing about Boreing Media?"
    text="Coverage, background, and a press contact are on the News page."
    primary={{ label: 'News & Press', href: '/news' }}
    secondary={{ label: 'Contact', href: '/contact' }}
  />
</BaseLayout>
