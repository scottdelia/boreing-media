---
import { footerColumns, platforms } from '../data/nav';
import { withBase } from '../lib/url';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg">
  <div class="container-x py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Logo />
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-muted">
          A media company built around a show, a studio, and a set of brands people actually want. Founded by Jeremy
          Boreing.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Listen on">
          {
            platforms.map((p) => (
              <li>
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex rounded-full border border-border px-3 py-1.5 text-xs font-medium text-muted transition-colors hover:border-gold hover:text-gold"
                >
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-7">
        {
          footerColumns.map((col) => (
            <div>
              <h2 class="eyebrow font-sans">{col.heading}</h2>
              <ul class="mt-4 space-y-3">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.external ? link.href : withBase(link.href)}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener' : undefined}
                      class="text-sm text-ink/80 transition-colors hover:text-gold"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="hairline my-10"></div>

    <div class="flex flex-col gap-4 text-xs leading-relaxed text-muted md:flex-row md:items-start md:justify-between">
      <p>&copy; {year} Boreing Media concept. Product names and titles belong to their respective owners.</p>
      <p class="max-w-xl md:text-right">
        Concept site. Not the official Boreing Media website and not affiliated with or endorsed by Boreing Media or
        Jeremy Boreing. Facts from public reporting; imagery is illustrative.
      </p>
    </div>
  </div>
</footer>
