---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, lead, align = 'left', class: className = '' } = Astro.props;
---

<div class={`max-w-2xl ${align === 'center' ? 'mx-auto text-center' : ''} ${className}`} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="mt-3 text-3xl font-medium tracking-tight sm:text-4xl lg:text-5xl">{title}</h2>
  {lead && <p class="mt-4 text-lg leading-relaxed text-muted">{lead}</p>}
  <slot />
</div>
