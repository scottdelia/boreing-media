---
import { withBase } from '../lib/url';

interface Action {
  label: string;
  href: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  primary: Action;
  secondary?: Action;
}
const { eyebrow, title, text, primary, secondary } = Astro.props;
---

<section class="container-x py-20 sm:py-28">
  <div class="card grain relative overflow-hidden px-6 py-14 text-center sm:px-12 sm:py-20" data-reveal>
    <div class="absolute -top-48 left-1/2 h-96 w-[44rem] -translate-x-1/2 rounded-full bg-gold/15 blur-3xl"></div>
    <div class="relative mx-auto max-w-2xl">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 class="mt-3 text-3xl font-medium tracking-tight sm:text-5xl">{title}</h2>
      {text && <p class="mt-4 text-lg text-muted">{text}</p>}
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={withBase(primary.href)} class="btn btn-primary">{primary.label}</a>
        {secondary && <a href={withBase(secondary.href)} class="btn btn-outline">{secondary.label}</a>}
      </div>
    </div>
  </div>
</section>
