---
import type { Title } from '../data/titles';
import { youtubeThumbFallback } from '../data/episodes';

interface Props {
  title: Title;
  wide?: boolean;
}
const { title: t, wide = false } = Astro.props;
const shape = wide ? 'aspect-video w-72 sm:w-80' : 'aspect-[2/3] w-40 sm:w-48';
const image = wide ? (t.backdrop ?? t.poster) : (t.poster ?? t.backdrop);
const isYouTube = image?.includes('i.ytimg.com') ?? false;
// Key art carries its own title. Only overlay text on wide stills or when there is no art.
const showCaption = wide || !image;
---

<button
  type="button"
  data-title={JSON.stringify(t)}
  class={`group relative shrink-0 snap-start overflow-hidden rounded-lg text-left transition-transform duration-300 ease-out-expo hover:z-10 hover:scale-105 focus-visible:z-10 focus-visible:scale-105 ${shape} ${t.palette}`}
  aria-label={`${t.title} (${t.year}). More info`}
>
  {
    image && (
      <img
        src={image}
        alt=""
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        class="absolute inset-0 size-full object-cover"
        onerror={isYouTube ? youtubeThumbFallback : undefined}
      />
    )
  }
  <span class="grain absolute inset-0"></span>
  {showCaption && <span class="absolute inset-0 bg-linear-to-t from-black/85 via-black/20 to-transparent"></span>}
  <span
    class="absolute left-3 top-3 rounded-full bg-black/60 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-white/90"
  >
    {t.kind}
  </span>
  {
    showCaption && (
      <span class="absolute inset-x-3 bottom-3">
        <span class="block font-display text-lg leading-tight text-white">{t.title}</span>
        <span class="mt-1 block text-xs text-white/70">
          {t.year} &middot; {t.meta}
        </span>
      </span>
    )
  }
</button>
