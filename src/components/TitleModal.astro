---
/** One shared dialog per page. Any element with a data-title JSON attribute opens it. */
---

<dialog
  data-title-modal
  class="m-auto max-h-[90vh] w-[min(92vw,44rem)] overflow-y-auto rounded-2xl border border-border bg-surface p-0 text-ink shadow-2xl backdrop:bg-black/75 backdrop:backdrop-blur-sm"
  aria-labelledby="modal-title"
>
  <div data-modal-art class="relative aspect-video overflow-hidden">
    <div class="grain absolute inset-0"></div>
    <div class="absolute inset-0 bg-linear-to-t from-surface via-surface/30 to-transparent"></div>
    <div class="absolute inset-x-6 bottom-5">
      <p data-modal-kind class="eyebrow"></p>
      <h2 id="modal-title" data-modal-title class="mt-2 text-3xl font-medium tracking-tight sm:text-4xl"></h2>
    </div>
    <form method="dialog" class="absolute right-4 top-4">
      <button
        type="submit"
        class="grid size-9 place-items-center rounded-full bg-black/50 text-ink transition-colors hover:bg-black/75"
        aria-label="Close"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </form>
  </div>
  <div class="p-6 sm:p-8">
    <p class="text-sm text-muted"><span data-modal-year></span> &middot; <span data-modal-meta></span></p>
    <p data-modal-tagline class="mt-3 font-display text-lg italic text-gold"></p>
    <p data-modal-blurb class="mt-3 leading-relaxed text-ink/90"></p>
    <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-muted">Jeremy Boreing</dt>
        <dd data-modal-credit class="mt-1 font-medium"></dd>
      </div>
      <div>
        <dt class="text-muted">Availability</dt>
        <dd class="mt-1 font-medium">Concept catalog. Not streaming here yet.</dd>
      </div>
    </dl>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-title-modal]');
  if (dialog) {
    const art = dialog.querySelector<HTMLElement>('[data-modal-art]');
    let currentPalette = '';

    const setText = (selector: string, value: string) => {
      const el = dialog.querySelector<HTMLElement>(selector);
      if (el) el.textContent = value;
    };

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-title]');
      if (!trigger) return;
      const t = JSON.parse(trigger.dataset.title || '{}');
      if (art) {
        if (currentPalette) art.classList.remove(currentPalette);
        currentPalette = t.palette || '';
        if (currentPalette) art.classList.add(currentPalette);
      }
      setText('[data-modal-kind]', t.kind ?? '');
      setText('[data-modal-title]', t.title ?? '');
      setText('[data-modal-year]', String(t.year ?? ''));
      setText('[data-modal-meta]', t.meta ?? '');
      setText('[data-modal-tagline]', t.tagline ?? '');
      setText('[data-modal-blurb]', t.blurb ?? '');
      setText('[data-modal-credit]', t.credit ?? '');
      dialog.showModal();
    });

    // Click on the backdrop closes the dialog.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
